{
  "name": "yskill-survivor",
  "version": "0.4.1",
  "private": true,
  "description": "YSkill Survivor — arcade survivor mobile (web + Android)",
  "scripts": {
    "test": "npm run test:assets",
    "test:assets": "node scripts/validate-runtime-assets.mjs",
    "start": "npx --yes serve www -p 5173",
    "api:dev": "npm run dev --prefix api",
    "api:deploy": "npm run deploy --prefix api",
    "deploy": "npx wrangler pages deploy www --project-name=yskillstudio --commit-dirty=true",
    "build:heroes": "python scripts/build-hero-pack.py --only male --bg green --cols 5 --rows 8 --frames 5 --inset 4",
    "build:heroes:female": "python scripts/build-hero-pack.py --only female --bg green --cols 8 --rows 8 --frames 8 --inset 4",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:init": "npx cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  }
}
